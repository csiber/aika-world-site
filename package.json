{
  "name": "aika-world-v2",
  "version": "2.5.2",
  "private": true,
  "description": "AIKA world — Full-stack Cloudflare Workers + Vue 3 + D1",
  "scripts": {
    "dev:worker": "wrangler dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create aika-world-db",
    "db:migrate": "wrangler d1 execute aika-world-db --file=./db/schema.sql",
    "db:migrate:preview": "wrangler d1 execute aika-world-db --local --file=./db/schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.69.0"
  },
  "dependencies": {
    "vite": "^7.3.1",
    "vue": "^3.5.29"
  }
}
