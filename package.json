{
        "name": "aika-world-site",
        "version": "0.1.0",
        "private": true,
        "scripts": {
                "dev": "next dev --turbopack",
                "clean:open-next": "rimraf .open-next",
                "build": "npm run clean:open-next && next build && opennextjs-cloudflare build --skipNextBuild",
                "start": "next start",
                "lint": "next lint",
                "deploy": "npm run clean:open-next && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
                "preview": "npm run clean:open-next && opennextjs-cloudflare build && opennextjs-cloudflare preview",
                "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
                "cf:build": "npm run clean:open-next && opennextjs-cloudflare build",
                "cf:preview": "npm run cf:build && wrangler dev --test --persist --local .open-next/worker.js",
                "cf:deploy": "npm run cf:build && wrangler deploy .open-next/worker.js"
        },
        "dependencies": {
                "@opennextjs/cloudflare": "^1.3.0",
                "geist": "^1.5.1",
                "next": "15.4.6",
		"react": "19.1.0",
		"react-dom": "19.1.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251014.0",
                "@eslint/eslintrc": "^3",
                "@tailwindcss/postcss": "^4",
                "@types/node": "^20.19.23",
                "@types/react": "^19",
                "@types/react-dom": "^19",
                "eslint": "^9",
                "eslint-config-next": "15.4.6",
                "rimraf": "^6.0.1",
                "tailwindcss": "^4",
                "typescript": "^5",
                "wrangler": "^4.44.0"
        }
}
