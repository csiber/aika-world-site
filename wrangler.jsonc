{
	"name": "aika-world",
        "main": ".open-next/worker.js",
	"assets": {
		"directory": ".open-next/assets"
	},
	"compatibility_date": "2025-10-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"account_id": "4e3646aaf967d8895e6596df2d62c3bf",
	"vars": {
		// ide jöhetnek nem titkos env-k, pl. PUBLIC_BASE_URL
	},
	"kv_namespaces": [
		{
			"binding": "AIKA_WORLD_KV",
			"id": "eb2949d7e43c42f1bfc98c59d095b7a7"
		}
	],
	"r2_buckets": [
		{
			"binding": "AIKA_WORLD_R2",
			"bucket_name": "aika-world-r2"
		}
	],
	"d1_databases": [
		{
			"binding": "AIKA_WORLD_DB",
			"database_name": "aika-world-db",
			"database_id": "9857d534-0700-427a-aab7-592e1fe95dbf"
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		}
	}
}